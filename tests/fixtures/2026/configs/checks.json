{
    "enabled": false,
    "fmsAttached": false,
    "robotMode": "both",
    "checks": [
        {
            "name": "Alert reported as warning",
            "entry": "/RealOutputs/Alerts/warnings",
            "expect": "empty",
            "severity": "warning",
            "while": "afterFirstEnable"
        },
        {
            "name": "Camera frames",
            "entry": "/RealOutputs/Vision/*/sending frames",
            "expectEntries": [
                "BCH",
                "BCL",
                "BL",
                "BR",
                "FRONT"
            ],
            "expect": {
                "always": true
            },
            "while": "enabled",
            "severity": "error"
        },
        {
            "name": "Device disconnected while enabled",
            "entry": "/Vision/*/Connected",
            "expect": {
                "always": true
            },
            "while": "enabled",
            "severity": "error"
        },
        {
            "name": "CANivore not OK",
            "entry": "/RealOutputs/CANivoreStatus/Status",
            "expect": {
                "always": "OK"
            },
            "severity": "error"
        },
        {
            "name": "Intake roller stalled",
            "entry": "/RealOutputs/Intake/RollerStalled",
            "expect": {
                "always": false
            },
            "severity": "warning"
        },
        {
            "name": "Shooter never reached a shooting mode",
            "entry": "/RealOutputs/ShooterModes/CurrentMode",
            "expect": {
                "atLeastOnce": "SHOOT_OTM"
            },
            "severity": "info"
        },
        {
            "name": "Device disconnected while enabled (broad, NT clients excluded)",
            "entry": "/**/*Connected*",
            "excludeEntry": [
                "/SystemStats/NTClients/**"
            ],
            "expect": {
                "always": true
            },
            "while": "enabled",
            "severity": "error"
        },
        {
            "name": "Drive motor over temperature",
            "entry": "/Drivetrain/*/DriveTemp",
            "expect": {
                "above": 40
            },
            "clearBelow": 38,
            "minDuration": 5.0,
            "unit": "C",
            "while": "afterFirstEnable",
            "severity": "warning"
        },
        {
            "name": "Drive motor hotter than its peers",
            "entry": "/Drivetrain/*/DriveTemp",
            "compare": "siblings",
            "statistic": "peak",
            "deviation": {
                "aboveSiblingsBy": 5
            },
            "unit": "C",
            "while": "afterFirstEnable",
            "severity": "warning"
        },
        {
            "name": "Steer motor hotter than its peers",
            "entry": "/Drivetrain/*/SteerTemp",
            "compare": "siblings",
            "statistic": "peak",
            "deviation": {
                "aboveSiblingsBy": 5
            },
            "unit": "C",
            "while": "afterFirstEnable",
            "severity": "warning"
        },
        {
            "name": "Peer deviation (deliberately sensitive, for test coverage)",
            "entry": "/Drivetrain/*/DriveTemp",
            "compare": "siblings",
            "statistic": "peak",
            "deviation": {
                "aboveSiblingsBy": 0.5
            },
            "unit": "C",
            "while": "afterFirstEnable",
            "severity": "info"
        }
    ]
}
