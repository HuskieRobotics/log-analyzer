{
    "enabled": false,
    "fmsAttached": false,
    "robotMode": "both",
    "checks": [
        {
            "name": "Alert reported as warning",
            "entry": "/RealOutputs/Alerts/warnings",
            "expect": "empty",
            "severity": "warning",
            "while": "afterFirstEnable"
        },
        {
            "name": "Camera frames",
            "entry": "/RealOutputs/Vision/*/sending frames",
            "expectEntries": [
                "BCH",
                "BCL",
                "BL",
                "BR",
                "FRONT"
            ],
            "expect": {
                "always": true
            },
            "while": "enabled",
            "severity": "error"
        },
        {
            "name": "Device disconnected while enabled",
            "entry": "/Vision/*/Connected",
            "expect": {
                "always": true
            },
            "while": "enabled",
            "severity": "error"
        },
        {
            "name": "CANivore not OK",
            "entry": "/RealOutputs/CANivoreStatus/Status",
            "expect": {
                "always": "OK"
            },
            "severity": "error"
        },
        {
            "name": "Intake roller stalled",
            "entry": "/RealOutputs/Intake/RollerStalled",
            "expect": {
                "always": false
            },
            "severity": "warning"
        },
        {
            "name": "Shooter never reached a shooting mode",
            "entry": "/RealOutputs/ShooterModes/CurrentMode",
            "expect": {
                "atLeastOnce": "SHOOT_OTM"
            },
            "severity": "info"
        },
        {
            "name": "Device disconnected while enabled (broad, NT clients excluded)",
            "entry": "/**/*Connected*",
            "excludeEntry": [
                "/SystemStats/NTClients/**"
            ],
            "expect": {
                "always": true
            },
            "while": "enabled",
            "severity": "error"
        }
    ]
}
